{% comment %}
  Markdown Reader Component
  
  Usage:
    {% include markdown-reader.liquid 
       path="assets/docs/example.md" 
       height="800px" 
    %}

  Parameters:
    - path (required): Path to the markdown file to load
    - height (optional): Height of the reader frame (default: "800px")
{% endcomment %}

{% assign reader_height = include.height | default: "800px" %}
{% assign md_path = include.path %}
{% assign reader_id = "md-reader-" | append: include.path | slugify %}

<div class="markdown-reader" id="{{ reader_id }}" 
     data-md-path="{{ md_path | relative_url }}"
     style="--reader-height: {{ reader_height }};">
  
  <!-- TOC Sidebar -->
  <nav class="markdown-reader-toc" aria-label="Table of Contents">
    <div class="toc-header">
      <span class="toc-title">Table of Content</span>
      <button class="toc-toggle" aria-label="Toggle TOC" title="Toggle TOC">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
          <path d="M9.828 3.414a2 2 0 1 1-3.656 0H1.5a.5.5 0 0 1 0-1h3.672a2 2 0 1 1 3.656 0H14.5a.5.5 0 0 1 0 1H9.828ZM8 4a1 1 0 1 0 0-2 1 1 0 0 0 0 2Zm0 9a1 1 0 1 0 0-2 1 1 0 0 0 0 2Zm5.5-2.5h-3.672a2 2 0 1 1-3.656 0H1.5a.5.5 0 0 1 0-1h3.672a2 2 0 1 1 3.656 0H14.5a.5.5 0 0 1 0 1Z"/>
        </svg>
      </button>
    </div>
    <ul class="toc-list"></ul>
  </nav>

  <!-- Content Area -->
  <div class="markdown-reader-content">
    <div class="markdown-reader-loading">
      <div class="loading-spinner"></div>
      <span>加载文档中...</span>
    </div>
    <article class="markdown-body"></article>
  </div>
</div>

<!-- Load marked.js from CDN -->
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<script>
(function() {
  const reader = document.getElementById('{{ reader_id }}');
  if (!reader) return;

  const mdPath = reader.dataset.mdPath;
  const tocList = reader.querySelector('.toc-list');
  const contentBody = reader.querySelector('.markdown-body');
  const loadingEl = reader.querySelector('.markdown-reader-loading');
  const tocToggle = reader.querySelector('.toc-toggle');
  const tocNav = reader.querySelector('.markdown-reader-toc');

  // Toggle TOC sidebar
  tocToggle.addEventListener('click', function() {
    tocNav.classList.toggle('collapsed');
  });

  // Fetch and render markdown
  fetch(mdPath)
    .then(function(response) {
      if (!response.ok) throw new Error('Failed to load: ' + mdPath);
      return response.text();
    })
    .then(function(mdText) {
      // Configure marked
      marked.setOptions({
        gfm: true,
        breaks: true,
        headerIds: true,
      });

      // Custom renderer to add IDs to headings for TOC linking
      const renderer = new marked.Renderer();
      const tocItems = [];
      let headingCounter = 0;

      renderer.heading = function(text, level, raw) {
        // marked v4+ passes an object; handle both formats
        if (typeof text === 'object') {
          raw = text.raw || text.text;
          level = text.depth;
          text = text.text;
        }
        const slug = 'md-heading-' + (++headingCounter);
        tocItems.push({ text: text, level: level, slug: slug });
        return '<h' + level + ' id="' + slug + '">' + text + '</h' + level + '>';
      };

      const html = marked.parse(mdText, { renderer: renderer });
      contentBody.innerHTML = html;

      // Hide loading
      if (loadingEl) loadingEl.style.display = 'none';

      // Build TOC
      buildTOC(tocItems);

      // Setup scroll spy
      setupScrollSpy();
    })
    .catch(function(err) {
      if (loadingEl) loadingEl.style.display = 'none';
      contentBody.innerHTML = '<div class="markdown-reader-error"><p>文档加载失败: ' + err.message + '</p></div>';
    });

  function buildTOC(items) {
    if (items.length === 0) {
      tocList.innerHTML = '<li class="toc-empty">暂无目录</li>';
      return;
    }

    var minLevel = Math.min.apply(null, items.map(function(i) { return i.level; }));
    var html = '';
    items.forEach(function(item) {
      var indent = item.level - minLevel;
      html += '<li class="toc-item toc-level-' + indent + '">' +
              '<a href="#' + item.slug + '" data-target="' + item.slug + '">' + item.text + '</a></li>';
    });
    tocList.innerHTML = html;

    // Smooth scroll on click
    tocList.querySelectorAll('a').forEach(function(link) {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        var targetId = this.getAttribute('data-target');
        var targetEl = document.getElementById(targetId);
        if (targetEl) {
          targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        // Update active state
        tocList.querySelectorAll('a').forEach(function(a) { a.classList.remove('active'); });
        this.classList.add('active');
      });
    });
  }

  function setupScrollSpy() {
    var contentArea = reader.querySelector('.markdown-reader-content');
    var links = tocList.querySelectorAll('a');
    if (links.length === 0) return;

    contentArea.addEventListener('scroll', function() {
      var scrollTop = contentArea.scrollTop;
      var activeLink = null;

      links.forEach(function(link) {
        var targetId = link.getAttribute('data-target');
        var targetEl = document.getElementById(targetId);
        if (targetEl) {
          var offset = targetEl.offsetTop - contentArea.offsetTop - 20;
          if (scrollTop >= offset) {
            activeLink = link;
          }
        }
      });

      links.forEach(function(a) { a.classList.remove('active'); });
      if (activeLink) activeLink.classList.add('active');
    });
  }
})();
</script>
